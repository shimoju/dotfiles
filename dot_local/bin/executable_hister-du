#!/bin/bash

set -euo pipefail

if (( $# != 0 )); then
  echo 'Usage: hister-du' >&2
  exit 2
fi

data_dir="$HOME/.local/share/hister"

printf 'Hister data: %s\n' "$data_dir"
if [[ -d "$data_dir" ]]; then
  du -sh "$data_dir"
  shopt -s nullglob dotglob
  entries=("$data_dir"/*)
  shopt -u nullglob dotglob
  if (( ${#entries[@]} > 0 )); then
    du -sh "${entries[@]}" 2>/dev/null || true
  fi
else
  echo '  not created'
fi

if [[ "$(uname -s)" == "Darwin" ]]; then
  for log in \
    "$HOME/Library/Logs/hister.log" \
    "$HOME/Library/Logs/hister.error.log"; do
    if [[ -f "$log" ]]; then
      du -h "$log"
    fi
  done
fi
