#!/bin/bash

set -euo pipefail

# https://github.com/ogulcancelik/herdr
skills add ogulcancelik/herdr -s herdr -a claude-code -a codex -g -y

# https://github.com/mattpocock/skills
skills add mattpocock/skills -s grill-me -s grilling -s grill-with-docs -s domain-modeling -a claude-code -a codex -g -y

# https://github.com/modem-dev/hunk
if command -v hunk >/dev/null; then
  {{- if eq .chezmoi.os "darwin" }}
  ln -sfn "$(brew --prefix hunk)/libexec/skills/hunk-review" "$HOME/.agents/skills/hunk-review"
  ln -sfn "$(brew --prefix hunk)/libexec/skills/hunk-review" "$HOME/.claude/skills/hunk-review"
  {{- end }}
fi
