# Zsh options
setopt COMBINING_CHARS
setopt INTERACTIVE_COMMENTS
setopt RC_QUOTES
setopt LONG_LIST_JOBS
setopt NOTIFY
setopt NO_FLOW_CONTROL
unsetopt MAIL_WARNING
unsetopt BG_NICE

HISTFILE="${ZDOTDIR:-$HOME}/.zsh_history"
HISTSIZE=50000
SAVEHIST=50000

setopt BANG_HIST
setopt EXTENDED_HISTORY
setopt SHARE_HISTORY
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_FIND_NO_DUPS
setopt HIST_IGNORE_SPACE
setopt HIST_SAVE_NO_DUPS
setopt HIST_VERIFY
setopt HIST_BEEP

setopt AUTO_CD
setopt AUTO_PUSHD
setopt PUSHD_IGNORE_DUPS
setopt PUSHD_SILENT
setopt PUSHD_TO_HOME
setopt CDABLE_VARS
setopt MULTIOS
setopt EXTENDED_GLOB

# Line editor
WORDCHARS='*?_-.[]~&;!#$%^(){}<>'
bindkey -e
# fzf handles history search instead of Ctrl-S's default forward search.
bindkey -M emacs -r '^S'

autoload -Uz edit-command-line
zle -N edit-command-line
bindkey -M emacs '^X^E' edit-command-line

if (( ${+aliases[run-help]} )); then
  unalias run-help
fi
autoload -Uz run-help run-help-git run-help-ip run-help-openssl run-help-sudo

zmodload zsh/terminfo
if [[ -n "$terminfo[kcbt]" ]]; then
  bindkey -M emacs "$terminfo[kcbt]" reverse-menu-complete
fi
if [[ -n "$terminfo[kLFT5]" ]]; then
  bindkey -M emacs "$terminfo[kLFT5]" emacs-backward-word
fi
if [[ -n "$terminfo[kRIT5]" ]]; then
  bindkey -M emacs "$terminfo[kRIT5]" emacs-forward-word
fi

for _key in "$terminfo[khome]" $'\e[H' $'\e[1~'; do
  [[ -n "$_key" ]] && bindkey -M emacs "$_key" beginning-of-line
done
for _key in "$terminfo[kend]" $'\e[F' $'\e[4~'; do
  [[ -n "$_key" ]] && bindkey -M emacs "$_key" end-of-line
done
if [[ -n "$terminfo[kdch1]" ]]; then
  bindkey -M emacs "$terminfo[kdch1]" delete-char
fi
unset _key

bindkey -M emacs '^Q' push-line-or-edit

autoload -Uz bracketed-paste-magic
zle -N bracketed-paste bracketed-paste-magic
zstyle ':bracketed-paste-magic' paste-finish quote-paste
zstyle -e ':bracketed-paste-magic:finish' quote-style '
  if [[ $PASTED == (http|https|ftp|ftps|file|ssh|sftp)://* || $PASTED == magnet:* ]]; then
    reply=(qq)
  else
    reply=(none)
  fi
'

# Aliases
_ls_version="$(command ls --version 2>&1)"
if [[ ${(@M)${(f)_ls_version}:#*(GNU|lsd|uutils) *} ]]; then
  export LS_COLORS=${LS_COLORS:-'di=34:ln=35:so=32:pi=33:ex=31:bd=36;01:cd=33;01:su=31;40;07:sg=36;40;07:tw=32;40;07:ow=33;40;07:'}
  alias ls='ls --color=auto'
else
  export LSCOLORS=${LSCOLORS:-'exfxcxdxbxGxDxabagacad'}
  alias ls='ls -G'
fi
unset _ls_version

alias l='ls'
alias la='ls -A'
alias ll='ls -lhA'

export GREP_COLOR='1;30;43'
export GREP_COLORS="mt=$GREP_COLOR"
alias grep='grep --color=auto'
alias diff='diff --color=auto'

# Plugin configuration
HISTORY_SUBSTRING_SEARCH_HIGHLIGHT_FOUND='bg=yellow,fg=black,bold'
HISTORY_SUBSTRING_SEARCH_HIGHLIGHT_NOT_FOUND='fg=red,bold,underline'

typeset -ga ZSH_HIGHLIGHT_HIGHLIGHTERS=(
  main
  brackets
  root
)

zstyle ':plugin:ez-compinit' compstyle prez
# Cache the completion dump for 20 hours and compile it when changed.
zstyle ':plugin:ez-compinit' use-cache yes

# Plugins
antidote_home="${ZDOTDIR:-$HOME}/.antidote"
if [[ -r "$antidote_home/antidote.zsh" ]]; then
  source "$antidote_home/antidote.zsh"
  antidote load "${ZDOTDIR:-$HOME}/.zsh_plugins.txt"
fi
unset antidote_home

# History key bindings
bindkey -M emacs ' ' magic-space

# These widgets only exist after the plugin has loaded successfully.
if (( ${+widgets[history-substring-search-up]} )); then
  if [[ -n "$terminfo[kcuu1]" ]]; then
    bindkey -M emacs "$terminfo[kcuu1]" history-substring-search-up
  fi
  if [[ -n "$terminfo[kcud1]" ]]; then
    bindkey -M emacs "$terminfo[kcud1]" history-substring-search-down
  fi
  bindkey -M emacs $'\e[A' history-substring-search-up
  bindkey -M emacs $'\e[B' history-substring-search-down
  bindkey -M emacs '^P' history-substring-search-up
  bindkey -M emacs '^N' history-substring-search-down
fi

# mise
if (( $+commands[mise] )); then
  eval "$(mise activate zsh)"

  _mise_completion_dir="${XDG_DATA_HOME:-$HOME/.local/share}/zsh/site-functions"
  _mise_completion_file="$_mise_completion_dir/_mise"

  if [[ ! -s "$_mise_completion_file" || "$commands[mise]" -nt "$_mise_completion_file" ]]; then
    command mkdir -p "$_mise_completion_dir"
    _mise_completion_tmp="${_mise_completion_file}.$$.tmp"
    if command mise completion zsh >| "$_mise_completion_tmp"; then
      command mv -f -- "$_mise_completion_tmp" "$_mise_completion_file"
    else
      command rm -f -- "$_mise_completion_tmp"
    fi
  fi

  fpath=("$_mise_completion_dir" $fpath)
  unset _mise_completion_dir _mise_completion_file _mise_completion_tmp
fi

# Source .zshrc.d
for _zshrc_file in "${ZDOTDIR:-$HOME}/.zshrc.d"/**/*.zsh(.N); do
  source "$_zshrc_file"
done
unset _zshrc_file
