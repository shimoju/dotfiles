emulate -L zsh
setopt prompt_subst

autoload -Uz add-zsh-hook
zmodload zsh/datetime
zmodload zsh/stat

prompt_shimoju_escape() {
  REPLY=${1//\%/%%}
}

prompt_shimoju_human_time() {
  local -i elapsed=$1 days hours minutes seconds
  local -a parts

  days=$(( elapsed / 86400 ))
  hours=$(( elapsed % 86400 / 3600 ))
  minutes=$(( elapsed % 3600 / 60 ))
  seconds=$(( elapsed % 60 ))

  (( days )) && parts+=("${days}d")
  (( hours )) && parts+=("${hours}h")
  (( minutes )) && parts+=("${minutes}m")
  (( seconds || ! ${#parts} )) && parts+=("${seconds}s")
  REPLY="${(j: :)parts}"
}

prompt_shimoju_shorten_path() {
  local original=$1 path_text=$1
  local -i limit=$2
  local prefix= result component candidate
  local -a components
  local -i index

  if (( limit <= 1 )); then
    REPLY='…'
    return
  fi
  if (( ${#path_text} <= limit )); then
    REPLY=$path_text
    return
  fi

  if [[ $path_text == '~/'* ]]; then
    prefix='~/'
    path_text=${path_text#\~/}
  elif [[ $path_text == /* ]]; then
    prefix='/'
    path_text=${path_text#/}
  fi

  components=("${(@s:/:)path_text}")
  result=${components[-1]}
  components[-1]=()
  for (( index = ${#components}; index >= 1; --index )); do
    component=${components[index]}
    candidate="${component}/${result}"
    (( ${#candidate} + 2 > limit )) && break
    result=$candidate
  done

  if [[ "${prefix}${result}" != $original ]]; then
    result="…/${result}"
  else
    result="${prefix}${result}"
  fi

  if (( ${#result} > limit )); then
    result="…${result[-$(( limit - 1 )),-1]}"
  fi
  REPLY=$result
}

prompt_shimoju_detect_identity() {
  typeset -g prompt_shimoju_show_identity=0
  typeset -g prompt_shimoju_identity_color=yellow

  if (( EUID == 0 )); then
    prompt_shimoju_show_identity=1
    prompt_shimoju_identity_color=red
  elif [[ -n ${SSH_CONNECTION-}${SSH_CLIENT-}${SSH_TTY-} ]]; then
    prompt_shimoju_show_identity=1
  elif [[ -n ${container-}${KUBERNETES_SERVICE_HOST-} ]] ||
      [[ -e /.dockerenv || -e /run/.containerenv ]]; then
    prompt_shimoju_show_identity=1
  fi
}

prompt_shimoju_set_title() {
  [[ $TERM == dumb || -n ${EMACS-}${INSIDE_EMACS-} ]] && return
  [[ $TTY == /dev/ttyS<-> ]] && return

  local title=$1
  title=${title//$'\e'/}
  title=${title//$'\a'/}
  title=${title//$'\n'/ }
  title=${title//$'\r'/ }
  print -n -r -- $'\e]0;'"${title}"$'\a'
}

prompt_shimoju_git_action() {
  local git_path

  git_path=$(command git rev-parse --git-path rebase-merge 2>/dev/null)
  if [[ -d $git_path ]]; then
    [[ -f $git_path/interactive ]] && REPLY='rebase-i' || REPLY='rebase-m'
    return
  fi

  git_path=$(command git rev-parse --git-path rebase-apply 2>/dev/null)
  if [[ -d $git_path ]]; then
    [[ -f $git_path/rebasing ]] && REPLY='rebase' || REPLY='am'
    return
  fi

  git_path=$(command git rev-parse --git-path MERGE_HEAD 2>/dev/null)
  [[ -f $git_path ]] && { REPLY='merge'; return; }
  git_path=$(command git rev-parse --git-path CHERRY_PICK_HEAD 2>/dev/null)
  [[ -f $git_path ]] && { REPLY='cherry-pick'; return; }
  git_path=$(command git rev-parse --git-path REVERT_HEAD 2>/dev/null)
  [[ -f $git_path ]] && { REPLY='revert'; return; }
  git_path=$(command git rev-parse --git-path BISECT_LOG 2>/dev/null)
  [[ -f $git_path ]] && { REPLY='bisect'; return; }
  REPLY=
}

prompt_shimoju_async_git_branch() {
  local generation=$1 workdir=$2 top branch action

  builtin cd -q -- "$workdir" 2>/dev/null || return
  top=$(command git rev-parse --show-toplevel 2>/dev/null)
  if [[ -n $top ]]; then
    branch=$(command git symbolic-ref --quiet --short HEAD 2>/dev/null) ||
      branch=$(command git rev-parse --short HEAD 2>/dev/null)
    prompt_shimoju_git_action
    action=$REPLY
  fi

  print -r -- ${(q)generation} ${(q)workdir} ${(q)top} ${(q)branch} ${(q)action}
}

prompt_shimoju_async_git_status() {
  local generation=$1 workdir=$2 line xy
  local -i unstaged=0 staged=0 untracked=0 ahead=0 behind=0 stash=0
  local -a fields

  builtin cd -q -- "$workdir" 2>/dev/null || return
  while IFS= read -r line; do
    case $line in
      ('# branch.ab '*)
        fields=(${=line})
        ahead=${fields[3]#+}
        behind=${fields[4]#-}
        ;;
      ('# stash '*)
        fields=(${=line})
        stash=${fields[3]}
        ;;
      ([12u]' '*)
        xy=${line[3,4]}
        [[ ${xy[1]} != '.' ]] && staged=1
        [[ ${xy[2]} != '.' ]] && unstaged=1
        ;;
      ('? '*) untracked=1 ;;
    esac
  done < <(
    GIT_OPTIONAL_LOCKS=0 command git status \
      --porcelain=v2 --branch --show-stash --untracked-files=normal --no-renames \
      2>/dev/null
  )

  local dirty= arrows= stash_marker=
  (( unstaged )) && dirty+='*'
  (( staged )) && dirty+='+'
  (( untracked )) && dirty+='?'
  (( behind )) && arrows+='⇣'
  (( ahead )) && arrows+='⇡'
  (( stash )) && stash_marker='≡'

  print -r -- ${(q)generation} ${(q)workdir} ${(q)dirty} ${(q)arrows} ${(q)stash_marker}
}

prompt_shimoju_async_git_aliases() {
  local generation=$1 workdir=$2 name expansion
  local -a aliases

  builtin cd -q -- "$workdir" 2>/dev/null || return
  while read -r name expansion; do
    if [[ $expansion == *pull* || $expansion == *fetch* ]]; then
      aliases+=("${name#alias.}")
    fi
  done < <(command git config --get-regexp '^alias\.' 2>/dev/null)

  print -r -- ${(q)generation} ${(q)workdir} ${(q)${(j: :)aliases}}
}

prompt_shimoju_async_git_fetch() {
  local generation=$1 workdir=$2 line arrows= success=0
  local -i ahead=0 behind=0
  local -a fields

  builtin cd -q -- "$workdir" 2>/dev/null || return
  if command git rev-parse --is-inside-work-tree &>/dev/null; then
    export GIT_TERMINAL_PROMPT=0
    export GIT_ASKPASS=true
    export GCM_INTERACTIVE=never
    export SSH_ASKPASS_REQUIRE=never
    export GIT_SSH_COMMAND="${GIT_SSH_COMMAND:-ssh} -o BatchMode=yes"
    unset GPG_TTY

    if command git -c gc.auto=0 -c maintenance.auto=0 fetch --quiet </dev/null 2>/dev/null; then
      success=1
      while IFS= read -r line; do
        if [[ $line == '# branch.ab '* ]]; then
          fields=(${=line})
          ahead=${fields[3]#+}
          behind=${fields[4]#-}
          break
        fi
      done < <(
        GIT_OPTIONAL_LOCKS=0 command git status \
          --porcelain=v2 --branch --untracked-files=no --no-renames 2>/dev/null
      )
      (( behind )) && arrows+='⇣'
      (( ahead )) && arrows+='⇡'
    fi
  fi

  print -r -- ${(q)generation} ${(q)workdir} $success ${(q)arrows}
}

prompt_shimoju_kube_signature() {
  (( $+commands[kubectl] )) || { REPLY=; return 1; }

  local config_path signature=${KUBECONFIG-}
  local -a config_paths file_stat
  local -A stat_result
  local -i found=0

  if [[ -n ${KUBECONFIG-} ]]; then
    config_paths=("${(@s/:/)KUBECONFIG}")
  else
    config_paths=("${HOME}/.kube/config")
  fi

  for config_path in $config_paths; do
    config_path=${config_path/#\~/$HOME}
    [[ -r $config_path ]] || continue
    stat_result=()
    zstat -H stat_result -- "$config_path" 2>/dev/null || continue
    signature+="|${config_path}:${stat_result[mtime]}:${stat_result[size]}"
    found=1
  done

  (( found )) || { REPLY=; return 1; }
  REPLY=$signature
}

prompt_shimoju_async_kube() {
  local generation=$1 workdir=$2 signature=$3 kubeconfig=$4
  local output context namespace

  if [[ -n $kubeconfig ]]; then
    export KUBECONFIG=$kubeconfig
  else
    unset KUBECONFIG
  fi

  output=$(command kubectl config view --minify \
    --output='jsonpath={.current-context}{"\t"}{.contexts[0].context.namespace}' \
    2>/dev/null)
  context=${output%%$'\t'*}
  if [[ $output == *$'\t'* ]]; then
    namespace=${output#*$'\t'}
  fi
  [[ -n $context && -z $namespace ]] && namespace=default

  print -r -- ${(q)generation} ${(q)workdir} ${(q)signature} ${(q)context} ${(q)namespace}
}

prompt_shimoju_async_lower_priority() {
  if (( $+commands[renice] )); then
    command renice 10 -p $$ >/dev/null 2>&1 || true
  fi
  if (( $+commands[ionice] )); then
    command ionice -c 3 -p $$ >/dev/null 2>&1 || true
  fi
}

prompt_shimoju_clear_git_state() {
  typeset -g prompt_shimoju_git_top=
  typeset -g prompt_shimoju_git_branch=
  typeset -g prompt_shimoju_git_action=
  typeset -g prompt_shimoju_git_dirty=
  typeset -g prompt_shimoju_git_arrows=
  typeset -g prompt_shimoju_git_stash=
  typeset -g prompt_shimoju_git_plain=
  typeset -g prompt_shimoju_git_prompt=
  typeset -ga prompt_shimoju_fetch_commands=(pull fetch)
}

prompt_shimoju_update_kube_render() {
  local plain= prompt=
  if [[ -n $prompt_shimoju_kube_context ]]; then
    plain="⎈ ${prompt_shimoju_kube_context}/${prompt_shimoju_kube_namespace}"
    prompt_shimoju_escape "$plain"
    prompt="%F{cyan}${REPLY}%f"
  fi
  typeset -g prompt_shimoju_kube_plain=$plain
  typeset -g prompt_shimoju_kube_prompt=$prompt
}

prompt_shimoju_update_git_render() {
  local plain= prompt= escaped

  if [[ -n $prompt_shimoju_git_branch ]]; then
    plain=$prompt_shimoju_git_branch
    prompt_shimoju_escape "$prompt_shimoju_git_branch"
    prompt="%F{green}${REPLY}%f"

    if [[ -n $prompt_shimoju_git_dirty ]]; then
      plain+=$prompt_shimoju_git_dirty
      prompt_shimoju_escape "$prompt_shimoju_git_dirty"
      prompt+="%F{yellow}${REPLY}%f"
    fi
    if [[ -n $prompt_shimoju_git_action ]]; then
      plain+=" ${prompt_shimoju_git_action}"
      prompt_shimoju_escape "$prompt_shimoju_git_action"
      prompt+=" %F{magenta}${REPLY}%f"
    fi
    if [[ -n $prompt_shimoju_git_arrows ]]; then
      plain+=" ${prompt_shimoju_git_arrows}"
      prompt+=" %F{cyan}${prompt_shimoju_git_arrows}%f"
    fi
    if [[ -n $prompt_shimoju_git_stash ]]; then
      plain+=" ${prompt_shimoju_git_stash}"
      prompt+=" %F{yellow}${prompt_shimoju_git_stash}%f"
    fi
  fi

  typeset -g prompt_shimoju_git_plain=$plain
  typeset -g prompt_shimoju_git_prompt=$prompt
}

prompt_shimoju_async_init() {
  if (( ${prompt_shimoju_async_ready:-0} )); then
    zpty -t prompt_shimoju &>/dev/null && return 0
    typeset -gi prompt_shimoju_async_ready=0
  fi
  (( $+functions[async_start_worker] )) || return 1

  if ! async_start_worker prompt_shimoju -u -n 2>/dev/null; then
    return 1
  fi
  async_register_callback prompt_shimoju prompt_shimoju_async_callback
  async_worker_eval prompt_shimoju prompt_shimoju_async_lower_priority 2>/dev/null || true
  typeset -gi prompt_shimoju_async_ready=1
}

prompt_shimoju_async_refresh() {
  local workdir=$PWD

  if [[ ${prompt_shimoju_async_pwd-} != $workdir ]]; then
    prompt_shimoju_clear_git_state
    typeset -g prompt_shimoju_async_pwd=$workdir
  fi

  (( ++prompt_shimoju_generation ))
  prompt_shimoju_async_init || return
  async_flush_jobs prompt_shimoju 2>/dev/null || true
  async_job prompt_shimoju prompt_shimoju_async_git_branch \
    $prompt_shimoju_generation "$workdir" || return
  async_job prompt_shimoju prompt_shimoju_async_git_status \
    $prompt_shimoju_generation "$workdir" || return
  async_job prompt_shimoju prompt_shimoju_async_git_aliases \
    $prompt_shimoju_generation "$workdir" || return
  async_job prompt_shimoju prompt_shimoju_async_git_fetch \
    $prompt_shimoju_generation "$workdir" || return

  if prompt_shimoju_kube_signature; then
    typeset -g prompt_shimoju_kube_current_signature=$REPLY
    if [[ $prompt_shimoju_kube_loaded_signature != $REPLY ]]; then
      async_job prompt_shimoju prompt_shimoju_async_kube \
        $prompt_shimoju_generation "$workdir" "$REPLY" "${KUBECONFIG-}" || return
    fi
  else
    typeset -g prompt_shimoju_kube_current_signature=
    typeset -g prompt_shimoju_kube_loaded_signature=
    typeset -g prompt_shimoju_kube_context=
    typeset -g prompt_shimoju_kube_namespace=
    prompt_shimoju_update_kube_render
  fi
}

prompt_shimoju_async_redraw() {
  prompt_shimoju_update_git_render
  prompt_shimoju_render
  [[ -o zle ]] && zle reset-prompt
  return 0
}

prompt_shimoju_async_callback() {
  setopt localoptions noshwordsplit
  local job=$1 code=$2 output=$3 next_pending=$6
  local -a result

  if [[ $job == '[async]' ]]; then
    if (( code == 2 || code == 3 || code == 130 )); then
      typeset -gi prompt_shimoju_async_ready=0
      async_stop_worker prompt_shimoju 2>/dev/null || true
      prompt_shimoju_clear_git_state
      if (( ! ${prompt_shimoju_async_restarting:-0} )); then
        typeset -gi prompt_shimoju_async_restarting=1
        prompt_shimoju_async_refresh
        prompt_shimoju_async_restarting=0
      fi
      prompt_shimoju_async_redraw
    fi
    return 0
  fi

  result=("${(Q@)${(z)output}}")
  (( ${#result} >= 2 )) || return 0
  [[ ${result[1]} == $prompt_shimoju_generation ]] || return 0
  [[ ${result[2]} == $PWD ]] || return 0

  case $job in
    (prompt_shimoju_async_git_branch)
      (( ${#result} == 5 )) || return 0
      prompt_shimoju_git_top=${result[3]}
      prompt_shimoju_git_branch=${result[4]}
      prompt_shimoju_git_action=${result[5]}
      if [[ -z $prompt_shimoju_git_top ]]; then
        prompt_shimoju_clear_git_state
      fi
      ;;
    (prompt_shimoju_async_git_status)
      (( ${#result} == 5 )) || return 0
      prompt_shimoju_git_dirty=${result[3]}
      prompt_shimoju_git_arrows=${result[4]}
      prompt_shimoju_git_stash=${result[5]}
      ;;
    (prompt_shimoju_async_git_aliases)
      (( ${#result} == 3 )) || return 0
      prompt_shimoju_fetch_commands=(pull fetch ${(s: :)result[3]})
      ;;
    (prompt_shimoju_async_git_fetch)
      (( ${#result} == 4 )) || return 0
      if (( result[3] )); then
        prompt_shimoju_git_arrows=${result[4]}
      fi
      ;;
    (prompt_shimoju_async_kube)
      (( ${#result} == 5 )) || return 0
      [[ ${result[3]} == $prompt_shimoju_kube_current_signature ]] || return 0
      prompt_shimoju_kube_loaded_signature=${result[3]}
      prompt_shimoju_kube_context=${result[4]}
      prompt_shimoju_kube_namespace=${result[5]}
      prompt_shimoju_update_kube_render
      ;;
    (*) return 0 ;;
  esac

  if (( next_pending )); then
    typeset -gi prompt_shimoju_async_render_requested=1
    return
  fi
  if (( ${prompt_shimoju_async_render_requested:-0} )); then
    prompt_shimoju_async_render_requested=0
  fi
  prompt_shimoju_async_redraw
  return 0
}

prompt_shimoju_command_conflicts_with_fetch() {
  local command_line=$1 token
  local -i seen_git=0
  local -a tokens
  tokens=("${(z)command_line}")

  for token in $tokens; do
    if (( ! seen_git )); then
      [[ $token == git || $token == hub ]] && seen_git=1
      continue
    fi
    (( ${prompt_shimoju_fetch_commands[(Ie)$token]} )) && return 0
  done
  return 1
}

prompt_shimoju_preexec() {
  if (( ${prompt_shimoju_async_ready:-0} )) &&
      prompt_shimoju_command_conflicts_with_fetch "$2"; then
    async_flush_jobs prompt_shimoju 2>/dev/null || true
  fi
  typeset -gF prompt_shimoju_command_started=$EPOCHREALTIME
  prompt_shimoju_set_title "${PWD:t}: $2"
}

prompt_shimoju_render() {
  setopt localoptions noshwordsplit

  local path_text=${(%):-%~}
  local time_text=${(%):-%D{%H:%M:%S}}
  local identity_plain identity_prompt suspended_plain suspended_prompt
  local duration_plain duration_prompt right_plain right_prompt
  local left_plain left_prompt path_prompt separator
  local -a prefix_plain prefix_prompt suffix_plain suffix_prompt
  local -i columns=${COLUMNS:-0} nonpath_width nonpath_count path_limit
  local -i left_width right_width padding=0

  (( columns > 0 )) || columns=80

  if ((${(M)#jobstates:#suspended:*})); then
    suspended_plain='✦'
    suspended_prompt='%F{red}✦%f'
    prefix_plain+=($suspended_plain)
    prefix_prompt+=($suspended_prompt)
  fi

  if (( prompt_shimoju_show_identity )); then
    identity_plain=${(%):-%n@%m}
    prompt_shimoju_escape "$identity_plain"
    identity_prompt="%F{${prompt_shimoju_identity_color}}${REPLY}%f"
    prefix_plain+=($identity_plain)
    prefix_prompt+=($identity_prompt)
  fi

  if [[ -n ${prompt_shimoju_git_plain-} ]]; then
    suffix_plain+=("$prompt_shimoju_git_plain")
    suffix_prompt+=("$prompt_shimoju_git_prompt")
  fi
  if [[ -n ${prompt_shimoju_kube_plain-} ]]; then
    suffix_plain+=("$prompt_shimoju_kube_plain")
    suffix_prompt+=("$prompt_shimoju_kube_prompt")
  fi

  if [[ -n ${prompt_shimoju_command_duration-} ]]; then
    duration_plain=$prompt_shimoju_command_duration
    prompt_shimoju_escape "$duration_plain"
    duration_prompt="%F{yellow}${REPLY}%f"
  fi

  right_plain="${duration_plain:+${duration_plain} }${time_text}"
  right_prompt="${duration_prompt:+${duration_prompt} }%F{cyan}${time_text}%f"

  nonpath_width=0
  local part
  for part in $prefix_plain $suffix_plain; do
    (( nonpath_width += ${#part} ))
  done
  nonpath_count=$(( ${#prefix_plain} + ${#suffix_plain} ))

  right_width=${#right_plain}
  path_limit=$(( columns - 1 - nonpath_width - nonpath_count - right_width - 2 ))

  if (( path_limit < 8 )); then
    right_plain=$duration_plain
    right_prompt=$duration_prompt
    right_width=${#right_plain}
    path_limit=$(( columns - 1 - nonpath_width - nonpath_count - right_width - (right_width ? 2 : 0) ))
  fi
  if (( path_limit < 8 )); then
    right_plain=
    right_prompt=
    right_width=0
    path_limit=$(( columns - 1 - nonpath_width - nonpath_count ))
  fi

  (( path_limit < 1 )) && path_limit=1
  prompt_shimoju_shorten_path "$path_text" $path_limit
  path_text=$REPLY
  prompt_shimoju_escape "$path_text"
  path_prompt="%F{blue}${REPLY}%f"

  local -a all_plain all_prompt
  all_plain=($prefix_plain "$path_text" $suffix_plain)
  all_prompt=($prefix_prompt "$path_prompt" $suffix_prompt)
  left_plain="${(j: :)all_plain}"
  left_prompt="${(j: :)all_prompt}"
  left_width=${#left_plain}

  if (( right_width )); then
    padding=$(( columns - left_width - right_width ))
    (( padding < 2 )) && padding=2
    printf -v separator '%*s' $padding ''
  else
    separator=
  fi

  typeset -g prompt_shimoju_render_left_plain=$left_plain
  typeset -g prompt_shimoju_render_right_plain=$right_plain
  typeset -gi prompt_shimoju_render_padding=$padding

  local indicator_color=green
  (( prompt_shimoju_last_status )) && indicator_color=red
  PROMPT="${left_prompt}${separator}${right_prompt}"$'\n'"%F{${indicator_color}}❯%f "
  RPROMPT=
}

prompt_shimoju_precmd() {
  local -i last_status=$?
  typeset -gi prompt_shimoju_last_status=$last_status
  typeset -g prompt_shimoju_command_duration=

  if [[ -n ${prompt_shimoju_command_started-} ]]; then
    local -i elapsed=$(( EPOCHREALTIME - prompt_shimoju_command_started ))
    if (( elapsed > 5 )); then
      prompt_shimoju_human_time $elapsed
      prompt_shimoju_command_duration=$REPLY
    fi
    unset prompt_shimoju_command_started
  fi

  prompt_shimoju_set_title "${(%):-%~}"
  prompt_shimoju_render
  prompt_shimoju_async_refresh
}

prompt_shimoju_detect_identity
typeset -gi prompt_shimoju_last_status=0
typeset -g prompt_shimoju_git_plain=
typeset -g prompt_shimoju_git_prompt=
typeset -g prompt_shimoju_kube_plain=
typeset -g prompt_shimoju_kube_prompt=
typeset -g prompt_shimoju_kube_context=
typeset -g prompt_shimoju_kube_namespace=
typeset -g prompt_shimoju_kube_current_signature=
typeset -g prompt_shimoju_kube_loaded_signature=
typeset -ga prompt_shimoju_fetch_commands=(pull fetch)
typeset -gi prompt_shimoju_generation=0
typeset -gi prompt_shimoju_async_ready=0
typeset -gi prompt_shimoju_async_restarting=0
typeset -gi prompt_shimoju_async_render_requested=0

add-zsh-hook -d precmd prompt_shimoju_precmd 2>/dev/null
add-zsh-hook -d preexec prompt_shimoju_preexec 2>/dev/null
add-zsh-hook precmd prompt_shimoju_precmd
