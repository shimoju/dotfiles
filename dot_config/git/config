[user]
	name = Hiroshi Shimoju
	email = hiroshi.shimoju@gmail.com
[color]
	ui = true
[core]
	autocrlf = input
	pager = delta
[interactive]
	diffFilter = delta --color-only
[merge]
	ff = false
	conflictStyle = zdiff3
[rebase]
	autosquash = true
	autostash = true
[fetch]
	prune = true
[pull]
	rebase = true
[push]
	default = simple
[alias]
	# status
	s = status --branch --short
	# show
	sh = show
	# commit
	ad = add
	c = commit
	ca = commit -a
	cam = commit -a --amend
	ce = commit --allow-empty
	# diff
	d = diff
	ds = diff --staged
	# branch
	b = branch
	ba = branch -va
	co = checkout
	cob = checkout -b
	cot = checkout --track
	com = "!f() { b=$(git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | cut -d/ -f4-); [ -z \"$b\" ] && b=$(git branch --list main master --format=\"%(refname:short)\" | head -n1); git checkout \"$b\"; }; f"
	# remote
	ft = fetch
	pl = pull
	ps = push
	# log
	l = log --decorate
	lp = log --decorate --stat --patch
	lo = log --oneline
	# rebase
	rb = rebase
	rbm = "!f() { b=$(git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | cut -d/ -f4-); [ -z \"$b\" ] && b=$(git branch --list main master --format=\"%(refname:short)\" | head -n1); git rebase \"$b\"; }; f"
	rbi = rebase -i
	rbc = rebase --continue
	rba = rebase --abort
	# stash
	st = stash
	sl = stash list
	sp = stash pop
	# cherry-pick
	cp = cherry-pick
	# worktree
	wt = worktree
	# hunk
	hd = -c core.pager=\"hunk pager\" diff
	hs = -c core.pager=\"hunk pager\" diff --staged
	hsh = -c core.pager=\"hunk pager\" show
[credential]
	helper = osxkeychain
[ghq]
	root = ~/dev/src
[gtr "editor"]
	default = vscode
[delta]
	features = catppuccin-mocha
	navigate = true
	tabs = 2
[delta "catppuccin-mocha"]
	blame-palette = "#1e1e2e #181825 #11111b #313244 #45475a"
	commit-decoration-style = "#6c7086" bold box ul
	dark = true
	file-decoration-style = "#6c7086"
	file-style = "#cdd6f4"
	hunk-header-decoration-style = "#6c7086" box ul
	hunk-header-file-style = bold
	hunk-header-line-number-style = bold "#a6adc8"
	hunk-header-style = file line-number syntax
	line-numbers-left-style = "#6c7086"
	line-numbers-minus-style = bold "#f38ba8"
	line-numbers-plus-style = bold "#a6e3a1"
	line-numbers-right-style = "#6c7086"
	line-numbers-zero-style = "#6c7086"
	# 35% red 65% base
	minus-emph-style = bold syntax "#694559"
	# 20% red 80% base
	minus-style = syntax "#493447"
	# 35% green 65% base
	plus-emph-style = bold syntax "#4e6356"
	# 20% green 80% base
	plus-style = syntax "#394545"
	map-styles = \
		bold purple => syntax "#5b4e74", \
		bold blue => syntax "#445375", \
		bold cyan => syntax "#446170", \
		bold yellow => syntax "#6b635b"
	# Should match the name of the bat theme
	syntax-theme = Catppuccin Mocha
